# Example environment variables
# NOTE: Provide SRV URI WITHOUT db/appName; code will append the database and authSource=admin automatically.
# If your password contains special characters, percent-encode them (e.g. @ => %40)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=xolt-shadab
PORT=8000
JWT_SECRET=change-me-dev
